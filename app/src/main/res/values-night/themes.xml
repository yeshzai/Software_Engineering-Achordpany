<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Theme.Achordpany" parent="Theme.MaterialComponents.DayNight.DarkActionBar">
        <!-- Window Background -->
        <item name="android:windowBackground">@color/background_dark</item>
        <!-- Primary brand color. -->
        <item name="colorPrimary">@color/dark_green</item>
        <item name="colorPrimaryVariant">@color/dark_green_700</item>
        <item name="colorOnPrimary">@color/text_light</item>
        <!-- Secondary brand color. -->
        <item name="colorSecondary">@color/light_green_200</item>
        <item name="colorSecondaryVariant">@color/light_green_200</item>
        <item name="colorOnSecondary">@color/text_light</item>
        <!-- Status bar color. -->
        <item name="android:statusBarColor">?attr/colorPrimaryVariant</item>
        <!-- Customize your theme here. -->
    </style>
</resources>
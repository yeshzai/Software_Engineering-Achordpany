<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/container"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- Dropdown Menu -->

    <!-- Active Tab Indicator -->

    <RelativeLayout
        android:id="@+id/header_layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="16dp"
        android:elevation="8dp">

        <!-- Back Button -->
        <ImageView
            android:id="@+id/back_button"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_alignParentStart="true"
            android:layout_centerVertical="true"
            android:layout_marginEnd="12dp"
            android:visibility="gone"
            android:src="@drawable/ic_return_black_24dp"
            android:contentDescription="Back"
            android:padding="4dp" />

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_toEndOf="@id/back_button"
            android:layout_centerVertical="true">

            <!-- ✅ Header Text & Subtext (Top Left, Dynamic Title) -->
            <TextView
                android:id="@+id/header_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentStart="true"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="Dashboard"
                android:textColor="@color/textColor"
                android:textSize="22sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/subtext"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_below="@id/header_title"
                android:layout_alignParentStart="true"
                android:layout_marginTop="5dp"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="Navigation section"
                android:textColor="@color/textColor"
                android:textSize="16sp" />
        </RelativeLayout>

        <!-- ✅ Profile Section (Top Right) -->
        <RelativeLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true" >

            <!-- Circular Profile Picture -->
            <de.hdodenhof.circleimageview.CircleImageView
                android:id="@+id/profile_image"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_gravity="end"
                android:background="@null"
                android:clickable="true"
                android:contentDescription="@string/profile_picture"
                android:elevation="16dp"
                android:focusable="true"
                android:padding="2dp"
                android:scaleType="centerCrop"
                android:src="@drawable/profile_placeholder" />

            <ImageButton
                android:id="@+id/profile_dropdown"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_alignBottom="@id/profile_image"
                android:layout_marginStart="6dp"
                android:layout_marginBottom="12dp"
                android:layout_toEndOf="@id/profile_image"
                android:background="@android:color/transparent"
                android:clickable="true"
                android:contentDescription="@string/dropdown_description"
                android:focusable="true"
                android:src="@drawable/ic_dropdown_dark_24dp" />
        </RelativeLayout>
    </RelativeLayout>

    <View
        android:id="@+id/active_tab_indicator"
        android:layout_width="75dp"
        android:layout_height="3dp"
        android:layout_gravity="bottom"
        android:layout_marginBottom="56dp"
        android:background="@color/primaryColor"
        android:visibility="visible"
        android:elevation="8dp" />

    <!-- Bottom Navigation View -->
    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/nav_view"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="0dp"
        android:layout_marginEnd="0dp"
        android:background="?android:attr/windowBackground"
        app:itemIconTint="@color/bottom_nav_color"
        app:itemTextColor="@color/bottom_nav_color"
        app:labelVisibilityMode="labeled"
        android:layout_gravity="bottom"
        app:menu="@menu/bottom_nav_menu" />

    <!-- Floating Action Buttons inside FrameLayout to create overlay effect -->
    <FrameLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:gravity="center"
        android:translationZ="8dp"
        android:background="@drawable/top_shadow"
        app:layout_anchor="@id/nav_view"
        app:layout_anchorGravity="center">

        <!-- Larger FAB (Background) -->
        <com.google.android.material.floatingactionbutton.FloatingActionButton
            android:id="@+id/fab_background"
            android:layout_width="70dp"
            android:layout_height="70dp"
            android:backgroundTint="@color/backgroundColor"
            android:elevation="0dp"
            app:useCompatPadding="false"
            android:outlineProvider="none"
            app:strokeWidth="0dp"
            app:borderWidth="0dp"
            android:clickable="false"
            android:focusable="false"
            android:importantForAccessibility="no" />

        <!-- Smaller FAB (Foreground with Icon) -->
        <com.google.android.material.floatingactionbutton.FloatingActionButton
            android:id="@+id/fab"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:layout_gravity="center"
            android:src="@drawable/ic_searchsong_black_64dp"
            android:backgroundTint="@color/primaryColor"
            android:tint="@color/textColor"
            android:elevation="8dp"
            android:contentDescription="@string/fab_search" />
    </FrameLayout>

    <!-- Fragment Container (Main Content) -->
    <androidx.fragment.app.FragmentContainerView
        android:id="@+id/nav_host_fragment"
        android:name="androidx.navigation.fragment.NavHostFragment"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:defaultNavHost="true"
        app:navGraph="@navigation/mobile_navigation" />

        <!--app:layout_constraintBottom_toTopOf="@id/nav_view"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent"-->

</androidx.coordinatorlayout.widget.CoordinatorLayout>
<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_light">


    <!-- Header Layout with Back Button and Logo Image -->
    <RelativeLayout
        android:id="@+id/headerLayout_new1"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="6dp"
        app:layout_constraintTop_toTopOf="parent">

        <!-- Logo Image -->
        <ImageView
            android:id="@+id/logoImageView_new1"
            android:layout_width="150dp"
            android:layout_height="70dp"
            android:layout_marginStart="10dp"
            android:contentDescription="Logo"
            android:src="@drawable/logo_light"
            tools:ignore="HardcodedText" />

        <!-- Back Button -->
        <ImageButton
            android:id="@+id/btnBack_new1"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_marginEnd="9dp"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/back"
            android:scaleType="centerInside"
            android:padding="8dp"
            android:src="@drawable/ic_return_black_36dp"/>
    </RelativeLayout>

    <!-- Return Button
    <ImageButton
        android:id="@+id/btnBack_new"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:layout_marginTop="24dp"
        android:contentDescription="@string/image_description"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.958"
        android:background="?attr/selectableItemBackgroundBorderless"
        app:srcCompat="@drawable/ic_return_black_24dp" />-->

    <!-- Logo Image
    <ImageView
        android:id="@+id/logoImageView_new"
        android:layout_width="150dp"
        android:layout_height="70dp"
        android:layout_marginStart="16dp"
        android:layout_marginBottom="36dp"
        android:contentDescription="Logo"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintBottom_toTopOf="@+id/heading1_new"
        app:srcCompat="@drawable/logo_light"
        tools:ignore="HardcodedText" />-->

    <!-- Main Heading -->
    <TextView
        android:id="@+id/heading1_new1"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="108dp"
        android:text="CREATE ACCOUNT"
        android:textSize="30sp"
        android:textStyle="bold"
        android:textColor="@android:color/black"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        tools:ignore="HardcodedText" />

    <!-- Subtitle -->
    <TextView
        android:id="@+id/heading2_new1"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="5dp"
        android:text="Sign up to get started"
        android:textSize="15sp"
        android:textColor="@android:color/black"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/heading1_new1"
        tools:ignore="HardcodedText"
        tools:layout_editor_absoluteY="220dp" />

    <!-- Username Input Field -->
    <EditText
        android:id="@+id/usernameText_new1"
        android:layout_width="300dp"
        android:layout_height="50dp"
        android:layout_marginTop="45dp"
        android:drawableStart="@drawable/ic_user_black"
        android:hint=" Username"
        android:importantForAutofill="no"
        android:inputType="text"
        style="@style/EditTextStyle"
        android:textSize="15sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/heading2_new1"
        tools:ignore="HardcodedText" />

    <!-- Email Address Input Field -->
    <EditText
        android:id="@+id/emailAddressText_new1"
        android:layout_width="300dp"
        android:layout_height="50dp"
        android:layout_marginTop="15dp"
        android:drawableStart="@drawable/ic_email_black"
        android:hint=" Email Address"
        android:importantForAutofill="no"
        android:inputType="textEmailAddress"
        style="@style/EditTextStyle"
        android:textSize="15sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/usernameText_new1"
        tools:ignore="HardcodedText" />

    <!-- Password Input Field -->
    <EditText
        android:id="@+id/passwordText_new1"
        android:layout_width="300dp"
        android:layout_height="50dp"
        android:layout_marginTop="15dp"
        android:drawableStart="@drawable/ic_lock_black"
        android:drawableEnd="@drawable/ic_eyehide_black"
        android:importantForAutofill="no"
        android:inputType="textVisiblePassword"
        android:hint="  Password"
        style="@style/EditTextStyle"
        android:textSize="15sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/emailAddressText_new1"
        tools:ignore="HardcodedText" />

    <!-- Confirm Password Input Field -->
    <EditText
        android:id="@+id/confirmPasswordText_new1"
        android:layout_width="300dp"
        android:layout_height="50dp"
        android:layout_marginTop="15dp"
        android:drawableStart="@drawable/ic_lock_black"
        android:drawableEnd="@drawable/ic_eyehide_black"
        android:importantForAutofill="no"
        android:inputType="textVisiblePassword"
        android:hint="  Confirm Password"
        style="@style/EditTextStyle"
        android:textSize="15sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/passwordText_new1"
        tools:ignore="HardcodedText" />

    <!-- Continue Button -->
    <Button
        android:id="@+id/btnContinue_new1"
        style="@style/RoundedButtonStyle"
        android:layout_marginStart="70dp"
        android:layout_marginEnd="70dp"
        android:layout_marginBottom="168dp"
        android:text=" Continue"
        android:textSize="18sp"
        android:textStyle="bold"
        android:textAllCaps="false"
        android:textColor="@color/black"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        tools:ignore="HardcodedText" />

    <!-- Log In Link -->
    <TextView
        android:id="@+id/textHaveAccount_new1"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="88dp"
        android:clickable="true"
        android:focusable="true"
        android:importantForAccessibility="yes"
        android:text="Already a member? Log In"
        android:textColor="#FF11843C"
        android:textSize="14sp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/btnContinue_new1"
        tools:ignore="HardcodedText,ContentDescription,LabelFor,TextSizeCheck" />


</androidx.constraintlayout.widget.ConstraintLayout>
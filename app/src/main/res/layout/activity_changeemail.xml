<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/backgroundColor">

    <!-- Header Layout with Back Button and Logo Image -->
    <RelativeLayout
        android:id="@+id/changeEmail_headerLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="6dp"
        app:layout_constraintTop_toTopOf="parent">

        <!-- Logo Image -->
        <ImageView
            android:id="@+id/changeEmail_logoImageView"
            android:layout_width="150dp"
            android:layout_height="70dp"
            android:layout_marginStart="10dp"
            android:contentDescription="Logo"
            android:src="@drawable/logo_footer"
            android:visibility="invisible"
            tools:ignore="HardcodedText" />

        <!-- Back Button -->
        <ImageButton
            android:id="@+id/changeEmail_btnBack"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_marginEnd="9dp"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/back"
            android:scaleType="centerInside"
            android:padding="8dp"
            android:src="@drawable/ic_return1"/>
    </RelativeLayout>

    <!--<EditText
        android:id="@+id/changeEmail_NewEmail"
        style="@style/EditTextStyle"
        android:layout_width="300dp"
        android:layout_height="50dp"
        android:layout_marginTop="260dp"
        android:drawableStart="@drawable/ic_user"
        android:hint="  New Email Address"
        android:importantForAutofill="no"
        android:inputType="textEmailAddress"
        android:textSize="15sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        tools:ignore="HardcodedText" />

    <EditText
        android:id="@+id/changeEmail_Password"
        style="@style/EditTextStyle"
        android:layout_width="300dp"
        android:layout_height="50dp"
        android:layout_marginTop="320dp"
        android:drawableStart="@drawable/ic_lock"
        android:drawableEnd="@drawable/ic_eyehide"
        android:hint="  Password Required"
        android:importantForAutofill="no"
        android:inputType="textPassword"
        android:textSize="15sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        tools:ignore="HardcodedText" />-->

    <!-- Email Field with Error Support -->
    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/changeEmail_NewEmailLayout"
        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
        android:layout_width="300dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="260dp"
        app:hintEnabled="true"
        app:hintAnimationEnabled="true"
        app:boxStrokeWidth="1dp"
        app:boxStrokeWidthFocused="2dp"
        app:startIconDrawable="@drawable/ic_user"
        android:hint="New Email Address"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:hintTextAppearance="@style/HintStyle">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/changeEmail_NewEmail"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:minHeight="56dp"
            android:paddingTop="12dp"
            android:paddingBottom="12dp"
            android:gravity="center_vertical"
            android:background="@null"
            android:importantForAutofill="no"
            android:inputType="textEmailAddress"
            android:textSize="15sp"/>
    </com.google.android.material.textfield.TextInputLayout>

    <!-- Password Field with Error Support android:drawableStart="@drawable/ic_lock"
        android:drawableEnd="@drawable/ic_eyehide" android:drawablePadding="10dp"-->
    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/changeEmail_PasswordLayout"
        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
        android:layout_width="300dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        app:startIconDrawable="@drawable/ic_lock"
        app:endIconMode="custom"
        app:endIconDrawable="@drawable/ic_eyehide"
        android:hint="Password Required"
        app:boxStrokeWidth="1dp"
        app:boxStrokeWidthFocused="2dp"
        app:hintAnimationEnabled="true"
        app:hintEnabled="true"
        app:hintTextAppearance="@style/HintStyle"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/changeEmail_NewEmailLayout">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/changeEmail_Password"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:paddingTop="12dp"
            android:paddingBottom="12dp"
            android:gravity="center_vertical"
            android:background="@null"
            android:importantForAutofill="no"
            android:inputType="textPassword"
            android:minHeight="56dp"
            android:textSize="15sp" />
    </com.google.android.material.textfield.TextInputLayout>

    <!-- Confirm Change Password Button -->
    <Button
        android:id="@+id/changeEmail_ChangeButton"
        style="@style/RoundedButtonStyle"
        android:layout_marginTop="420dp"
        android:text="Change Email"
        android:textAllCaps="false"
        android:textColor="@color/textColor"
        android:textSize="18sp"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        tools:ignore="HardcodedText" />

</androidx.constraintlayout.widget.ConstraintLayout>
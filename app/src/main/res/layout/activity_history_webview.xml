<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <!-- ✅ Header Layout with Back Button, Title, and Link -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="16dp"
        android:layout_marginTop="10dp">

        <!-- ✅ Back Button (Top-Left) -->
        <ImageButton
            android:id="@+id/btnBack_History"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/back"
            android:scaleType="centerInside"
            android:padding="8dp"
            android:src="@drawable/ic_return_black_36dp"
            android:layout_alignParentStart="true"/>

        <!-- ✅ Centered Title -->
        <TextView
            android:id="@+id/txtTitle_History"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerHorizontal="true"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="Placeholder Title"
            android:textColor="@android:color/black"
            android:textSize="22sp"
            android:textStyle="bold" />

        <!-- ✅ Placeholder Link (Under Title) -->
        <TextView
            android:id="@+id/txtLink_History"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="www.example.com"
            android:textSize="14sp"
            android:textColor="@android:color/holo_blue_dark"
            android:maxLines="1"
            android:ellipsize="end"
            android:layout_below="@id/txtTitle_History"
            android:layout_centerHorizontal="true"/>
    </RelativeLayout>

    <WebView
        android:id="@+id/webView_History"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="@android:color/darker_gray"/>
</LinearLayout>
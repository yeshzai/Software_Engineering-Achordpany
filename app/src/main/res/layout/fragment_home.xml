<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/scrollView"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="0dp"
    android:background="@color/backgroundColor">

    <!-- Container for all sections -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@color/homeBG"
        android:layout_marginTop="100dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/rounded_bg_home"
            android:paddingBottom="20dp"
            android:layout_marginTop="0dp">

            <!-- ===== Bookmarks Section Container ===== -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginStart="16dp"
                android:layout_marginEnd="16dp"
                android:paddingBottom="16dp"
                android:background="@drawable/rounded_bg_bookmarks_home">

                <!-- Bookmarks Header -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingVertical="8dp">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Bookmarks"
                        android:textSize="20sp"
                        android:textStyle="bold"
                        android:layout_marginStart="20dp"
                        android:layout_marginTop="5dp"
                        android:textColor="@color/textColor"
                        tools:ignore="HardcodedText" />
                    <View
                        android:layout_width="0dp"
                        android:layout_height="0dp"
                        android:layout_weight="1" />

                    <TextView
                        android:id="@+id/bookmarks_OpenAllButton"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="25dp"
                        android:text="All"
                        android:textColor="@color/subText"
                        android:textSize="14sp"
                        tools:ignore="HardcodedText" />
                </LinearLayout>

                <!-- Row of Bookmark Cards -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:baselineAligned="false" >

                    <!-- First Bookmark Card -->
                    <LinearLayout
                        android:id="@+id/bookmarkBoard1"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="20dp"
                        android:layout_marginEnd="8dp"
                        android:layout_weight="1"
                        android:background="@drawable/rounded_background_home"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:padding="10dp">

                        <!-- Left section: Text info -->
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical"
                            tools:ignore="NestedWeights">

                            <!-- Title -->
                            <TextView
                                android:id="@+id/bookmarkBoard1_Title"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Title"
                                android:maxLines="1"
                                android:ellipsize="end"
                                android:textColor="@color/textColor"
                                android:textSize="16sp"
                                android:textStyle="bold"
                                tools:ignore="HardcodedText" />

                            <!-- Artist -->
                            <TextView
                                android:id="@+id/bookmarkBoard1_Artist"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Artist"
                                android:textColor="@color/subText"
                                android:textSize="10sp"
                                tools:ignore="HardcodedText,SmallSp,TextSizeCheck" />

                            <!-- Genre -->
                            <TextView
                                android:id="@+id/bookmarkBoard1_Genre"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Genre"
                                android:textColor="@color/subText"
                                android:textSize="12sp"
                                tools:ignore="HardcodedText" />
                        </LinearLayout>

                        <!-- Right section: Arrow/Share icon -->
                        <ImageView
                            android:id="@+id/bookmarkBoard1_OpenButton"
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:layout_marginStart="8dp"
                            android:contentDescription="redirect"
                            android:src="@drawable/ic_redirect"
                            tools:ignore="HardcodedText" />
                    </LinearLayout>

                    <!-- Second Bookmark Card -->
                    <LinearLayout
                        android:id="@+id/bookmarkBoard2"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="5dp"
                        android:layout_marginEnd="20dp"
                        android:layout_weight="1"
                        android:background="@drawable/rounded_background_home"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:padding="10dp">

                        <!-- Left section: Text info -->
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical"
                            tools:ignore="NestedWeights">

                            <!-- Title -->
                            <TextView
                                android:id="@+id/bookmarkBoard2_Title"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Title"
                                android:maxLines="1"
                                android:ellipsize="end"
                                android:textColor="@color/textColor"
                                android:textSize="16sp"
                                android:textStyle="bold"
                                tools:ignore="HardcodedText" />

                            <!-- Artist -->
                            <TextView
                                android:id="@+id/bookmarkBoard2_Artist"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Artist"
                                android:textColor="@color/subText"
                                android:textSize="10sp"
                                tools:ignore="HardcodedText, smallSp" />

                            <!-- Genre -->
                            <TextView
                                android:id="@+id/bookmarkBoard2_Genre"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Genre"
                                android:textColor="@color/subText"
                                android:textSize="12sp"
                                tools:ignore="HardcodedText" />
                        </LinearLayout>

                        <!-- Right section: Arrow/Share icon -->
                        <ImageView
                            android:id="@+id/bookmarkBoard2_OpenButton"
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:layout_marginStart="8dp"
                            android:contentDescription="redirect"
                            android:src="@drawable/ic_redirect"
                            tools:ignore="HardcodedText" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>

            <!-- ===== Recent Searches Section Container ===== -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/rounded_bg_recent_home"
                android:paddingBottom="16dp">

                <!-- Recent Searches Header -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingVertical="8dp"
                    android:paddingTop="20dp"
                    android:layout_marginTop="15dp">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Recent Searches"
                        android:textSize="20sp"
                        android:textStyle="bold"
                        android:textColor="@color/textColor"
                        android:layout_marginStart="33dp"
                        tools:ignore="HardcodedText" />
                    <View
                        android:layout_width="0dp"
                        android:layout_height="0dp"
                        android:layout_weight="1" />

                    <TextView
                        android:id="@+id/recentSearches_OpenAllButton"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="40dp"
                        android:text="All"
                        android:textColor="@color/subText"
                        android:textSize="14sp"
                        tools:ignore="HardcodedText" />
                </LinearLayout>

                <!-- Recent Searches Cards Container -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <!-- "Viva La Vida" Item -->
                    <LinearLayout
                        android:id="@+id/recentSearch_Board1"
                        android:layout_width="335dp"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center_horizontal"
                        android:layout_marginStart="20dp"
                        android:layout_marginEnd="20dp"
                        android:background="@drawable/rounded_background"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:padding="12dp">
                        <!-- Music Icon -->
                        <ImageView
                            android:layout_width="40dp"
                            android:layout_height="40dp"
                            android:layout_marginEnd="10dp"
                            android:contentDescription="Music note"
                            android:src="@drawable/ic_music_note"
                            tools:ignore="HardcodedText" />
                        <!-- Song Info -->
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical"
                            android:paddingStart="8dp"
                            android:paddingEnd="8dp">

                            <TextView
                                android:id="@+id/recentSearch1_Title"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Title"
                                android:maxLines="1"
                                android:ellipsize="end"
                                android:textColor="@color/textColor"
                                android:textSize="16sp"
                                android:textStyle="bold"
                                tools:ignore="HardcodedText" />

                            <TextView
                                android:id="@+id/recentSearch1_ArtistGenre"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Artist - Genre"
                                android:textColor="@color/subText"
                                android:textSize="14sp"
                                tools:ignore="HardcodedText" />

                            <TextView
                                android:id="@+id/recentSearch1_Site"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="site"
                                android:textColor="@color/subText"
                                android:textSize="12sp"
                                tools:ignore="HardcodedText" />
                        </LinearLayout>
                        <!-- Bookmark Icon -->
                        <ImageView
                            android:id="@+id/recentSearch1_BookmarkButton"
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:layout_marginEnd="10dp"
                            android:contentDescription="Bookmark"
                            android:src="@drawable/ic_bookmark"
                            tools:ignore="HardcodedText" />
                        <!-- Arrow Icon -->
                        <ImageView
                            android:id="@+id/recentSearch1_OpenButton"
                            android:layout_width="15dp"
                            android:layout_height="15dp"
                            android:layout_marginStart="8dp"
                            android:layout_marginEnd="10dp"
                            android:contentDescription="Arrow"
                            android:src="@drawable/ic_arrow"
                            tools:ignore="HardcodedText" />
                    </LinearLayout>

                    <!-- "Let Her Go" Item -->
                    <LinearLayout
                        android:id="@+id/recentSearch_Board2"
                        android:layout_width="335dp"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center_horizontal"
                        android:layout_marginStart="20dp"
                        android:layout_marginTop="10dp"
                        android:layout_marginEnd="20dp"
                        android:background="@drawable/rounded_background"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:padding="12dp">
                        <!-- Music Icon -->
                        <ImageView
                            android:layout_width="40dp"
                            android:layout_height="40dp"
                            android:layout_marginEnd="10dp"
                            android:contentDescription="Music note"
                            android:src="@drawable/ic_music_note"
                            tools:ignore="HardcodedText" />
                        <!-- Song Info -->
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical"
                            android:paddingStart="8dp"
                            android:paddingEnd="8dp">

                            <TextView
                                android:id="@+id/recentSearch2_Title"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Title"
                                android:maxLines="1"
                                android:ellipsize="end"
                                android:textColor="@color/textColor"
                                android:textSize="16sp"
                                android:textStyle="bold"
                                tools:ignore="HardcodedText" />

                            <TextView
                                android:id="@+id/recentSearch2_ArtistGenre"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Artist - Genre"
                                android:textColor="@color/subText"
                                android:textSize="14sp"
                                tools:ignore="HardcodedText" />

                            <TextView
                                android:id="@+id/recentSearch2_Site"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="site"
                                android:textColor="@color/subText"
                                android:textSize="12sp"
                                tools:ignore="HardcodedText" />
                        </LinearLayout>
                        <!-- Bookmark Icon -->
                        <ImageView
                            android:id="@+id/recentSearch2_BookmarkButton"
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:layout_marginEnd="10dp"
                            android:contentDescription="Bookmark"
                            android:src="@drawable/ic_bookmark"
                            tools:ignore="HardcodedText,ImageContrastCheck" />
                        <!-- Arrow Icon -->
                        <ImageView
                            android:id="@+id/recentSearch2_OpenButton"
                            android:layout_width="15dp"
                            android:layout_height="15dp"
                            android:layout_marginStart="8dp"
                            android:layout_marginEnd="10dp"
                            android:contentDescription="Arrow"
                            android:src="@drawable/ic_arrow"
                            tools:ignore="HardcodedText" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>

        <!-- ===== Recommendations Section Container ===== -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"
            android:paddingBottom="30dp"
            android:background="@drawable/rounded_bg_bookmarks_home">

            <!-- Recommendation Header -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingVertical="8dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="20dp"
                    android:layout_marginTop="5dp"
                    android:text="Recommendations"
                    android:textColor="@color/textColor"
                    android:textSize="20sp"
                    android:textStyle="bold"
                    tools:ignore="HardcodedText" />
                <View
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:layout_weight="1" />

                <TextView
                    android:id="@+id/recommendations_OpenAllButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="25dp"
                    android:text="All"
                    android:textColor="@color/subText"
                    android:textSize="14sp"
                    tools:ignore="HardcodedText" />
            </LinearLayout>

            <!-- Row of Recommendation Cards -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:baselineAligned="false" >

                <!-- First Recommendation Card -->
                <LinearLayout
                    android:id="@+id/recommendations1_Board"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="20dp"
                    android:layout_marginEnd="8dp"
                    android:layout_weight="1"
                    android:background="@drawable/rounded_background_home"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:padding="10dp">

                    <!-- Left section: Text info -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        tools:ignore="NestedWeights">

                        <!-- Title -->
                        <TextView
                            android:id="@+id/recommendations1_Title"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Title"
                            android:maxLines="1"
                            android:ellipsize="end"
                            android:textColor="@color/textColor"
                            android:textSize="16sp"
                            android:textStyle="bold"
                            tools:ignore="HardcodedText" />

                        <!-- Artist -->
                        <TextView
                            android:id="@+id/recommendations1_Artist"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Artist"
                            android:textColor="@color/subText"
                            android:textSize="10sp"
                            tools:ignore="HardcodedText, smallSp" />

                        <!-- Genre -->
                        <TextView
                            android:id="@+id/recommendations1_Genre"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Genre"
                            android:textColor="@color/subText"
                            android:textSize="12sp"
                            tools:ignore="HardcodedText" />
                    </LinearLayout>

                    <!-- Right section: Arrow/Share icon -->
                    <ImageView
                        android:id="@+id/recommendations1_OpenButton"
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:layout_marginStart="8dp"
                        android:layout_marginBottom="12dp"
                        android:contentDescription="recommended1"
                        android:src="@drawable/ic_recommendation"
                        tools:ignore="HardcodedText" />
                </LinearLayout>

                <!-- Second Recommendation Card -->
                <LinearLayout
                    android:id="@+id/recommendations2_Board"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="5dp"
                    android:layout_marginEnd="20dp"
                    android:layout_weight="1"
                    android:background="@drawable/rounded_background_home"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:padding="10dp">

                    <!-- Left section: Text info -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        tools:ignore="NestedWeights">

                        <!-- Title -->
                        <TextView
                            android:id="@+id/recommendations2_Title"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Title"
                            android:maxLines="1"
                            android:ellipsize="end"
                            android:textColor="@color/textColor"
                            android:textSize="16sp"
                            android:textStyle="bold"
                            tools:ignore="HardcodedText" />

                        <!-- Artist -->
                        <TextView
                            android:id="@+id/recommendations2_Artist"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Artist"
                            android:textColor="@color/subText"
                            android:textSize="10sp"
                            tools:ignore="HardcodedText, smallSp" />

                        <!-- Genre -->
                        <TextView
                            android:id="@+id/recommendations2_Genre"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Genre"
                            android:textColor="@color/subText"
                            android:textSize="12sp"
                            tools:ignore="HardcodedText" />
                    </LinearLayout>

                    <!-- Right section: Arrow/Share icon -->
                    <ImageView
                        android:id="@+id/recommendations2_OpenButton"
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:layout_marginStart="8dp"
                        android:layout_marginBottom="12dp"
                        android:contentDescription="recommended2"
                        android:src="@drawable/ic_recommendation"
                        tools:ignore="HardcodedText" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</ScrollView>

<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Heading1">
        <item name="android:textSize">30sp</item>
        <item name="android:textColor">@color/textColor</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="EditTextStyle">
        <item name="android:textColor">@color/fieldInputs</item>
        <item name="android:textColorHint">@color/fieldInputs</item>
        <item name="android:backgroundTint">@color/edittext_underline_color</item>
    </style>

    <style name="HintStyle" parent="TextAppearance.MaterialComponents.Body1">
        <item name="android:textSize">12sp</item>
        <item name="android:translationY">-2dp</item>
    </style>

    <style name="Widget.BottomNavigationView" parent="Widget.MaterialComponents.BottomNavigationView">
        <item name="itemIconTint">@color/bottom_nav_color</item>
        <item name="itemTextColor">@color/bottom_nav_color</item>
    </style>

    <style name="RoundedButtonStyle">
        <item name="android:background">@drawable/btn_login_light</item>
        <item name="android:textColor">@color/backgroundColor</item> <!-- White text color -->
        <item name="android:textSize">16sp</item> <!-- Text size -->
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
    </style>

</resources>